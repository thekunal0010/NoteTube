# Copy to .env.local and adjust. .env.local is gitignored; this file is not.
#
# Anything prefixed NEXT_PUBLIC_ is embedded into the JavaScript sent to the
# browser. Never put a secret here — API keys for Supadata and Gemini belong in
# backend/.env and are used only by the backend.

# Base URL of the NoteTube backend API.
#
# Leave empty for local development: the frontend then derives the backend from
# the page's own hostname on port 5000, which covers both localhost and testing
# from another device on the same network.
#
# Set this when the frontend and backend are on different hosts — for example a
# frontend on Render talking to a backend on EC2:
#   NEXT_PUBLIC_API_URL=https://api.example.com
#
# The backend must also list this frontend's origin in its
# NOTETUBE_ALLOWED_ORIGINS, or the browser will block the requests.
NEXT_PUBLIC_API_URL=
