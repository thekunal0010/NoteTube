# Copy to .env and fill in real values. .env is gitignored; this file is not.
# Never commit real credentials.

# --- Required ---

# MongoDB Atlas connection string.
MONGO_URI=

# Signing key for auth tokens. Use a long random string.
JWT_SECRET=

# Supadata API key — the production YouTube transcript provider.
# Backend only: this must never be exposed to the frontend or prefixed
# NEXT_PUBLIC_. Required unless NOTETUBE_TRANSCRIPT_PROVIDER=local.
SUPADATA_API_KEY=

# Gemini API key — the production AI provider (notes, flashcards, MCQs).
# Backend only, same rules as above. Required unless NOTETUBE_LLM_PROVIDER=local.
GEMINI_API_KEY=


# --- Optional ---

# AI provider: "gemini" (default) or "local".
#   gemini — production. An HTTPS call, so no torch is needed.
#   local  — development on a CUDA GPU, via Qwen2.5 through torch (~4.2GB,
#            installed by requirements-local.txt).
# Chosen explicitly rather than by key presence: falling back to the local
# model because a production key was missing would turn a config mistake into
# a 3GB model load on a machine with no GPU.
NOTETUBE_LLM_PROVIDER=gemini

# Gemini model. Defaults to the economy tier, which suits short templated
# extraction prompts on a low-traffic project.
NOTETUBE_GEMINI_MODEL=gemini-3.5-flash-lite

# Gemini request timeout, in MILLISECONDS (the SDK's unit, not seconds).
NOTETUBE_GEMINI_TIMEOUT_MS=90000

# Origins allowed to call the API and open a Socket.IO connection,
# comma-separated. Applies to both CORS and Socket.IO.
#
# Unset defaults to http://localhost:3000,http://127.0.0.1:3000.
# Add any other origin you actually use, for example a LAN address while
# testing from a phone, or the deployed frontend:
#   NOTETUBE_ALLOWED_ORIGINS=http://localhost:3000,http://192.168.1.2:3000
#   NOTETUBE_ALLOWED_ORIGINS=https://notetube.example.com
#
# "*" is accepted but logs a warning and must not be used in production: it
# lets any site on the internet script authenticated calls against this API.
NOTETUBE_ALLOWED_ORIGINS=

# Development only. Set to 1 to have /forgot-password return the reset token in
# its response, which is the only way to complete a password reset while this
# application has no email delivery.
#
# MUST stay unset in production: with it on, anyone who knows an email address
# can mint a working reset token for it and take the account over.
NOTETUBE_EXPOSE_RESET_TOKEN=

# Transcript provider: "supadata" (default) or "local".
#   supadata — production. Works from a datacenter, where direct YouTube
#              access does not.
#   local    — development only, via youtube-transcript-api. Free, but
#              YouTube blocks datacenter IPs, so it fails on a server.
# Chosen explicitly rather than by key presence: a production box with a
# missing key should say so, not quietly switch to a provider that will fail.
NOTETUBE_TRANSCRIPT_PROVIDER=supadata

# Supadata retrieval mode. "native" (default) fetches only transcripts that
# already exist. "auto"/"generate" fall back to AI transcription, which is
# billed differently — set deliberately.
NOTETUBE_SUPADATA_MODE=native

# Set to 1 to run Flask's auto-reloader while editing backend code. Off by
# default: it forks a second process that reloads the local model.
NOTETUBE_RELOAD=0

# Force the local AI model onto CPU ("cpu") instead of autodetecting CUDA.
NOTETUBE_DEVICE=

# Override the local instruct model, e.g. Qwen/Qwen2.5-3B-Instruct.
NOTETUBE_LLM_MODEL=

# Generation batch size for the local model. Lower this first if it OOMs.
NOTETUBE_LLM_BATCH=4
