venv/
node_modules/
.next/
__pycache__/

# Environment variables / secrets — never commit real credentials.
# Keep an .env.example tracked if you add one; only *values* files are ignored.
.env
.env.*
!.env.example
!.env.*.example

# Private keys, certs, and common credential file names
*.pem
*.key
*.p12
*.pfx
*credentials*.json
*serviceAccount*.json
*service-account*.json

# TypeScript incremental build cache
*.tsbuildinfo

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/

# Runtime logs from local dev/prod server processes
*.log

# Next.js auto-generates and rewrites this on every dev/build run
next-env.d.ts
